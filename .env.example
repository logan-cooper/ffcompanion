# Copy to .env and fill in. .env is gitignored; never commit real values.

# Anthropic API key. Not needed until Phase 5 (the agent loop).
ANTHROPIC_API_KEY=

# Local DuckDB file. Relative paths resolve against the project root.
DB_PATH=data/advisor.duckdb

# Where raw nflverse Parquet and cached Sleeper payloads land.
CACHE_DIR=data/cache

# Sleeper league id used when a command doesn't name one.
# Find it in the league URL: sleeper.com/leagues/<DEFAULT_LEAGUE_ID>/...
DEFAULT_LEAGUE_ID=
