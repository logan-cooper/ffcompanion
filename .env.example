# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# There is no API key here and no per-token cost. Inference runs locally
# through Ollama, so the app is free to run for you and for anyone you share
# it with. See docs/ROADMAP.md Phase 5.

# Ollama model tag used for the agent loop. Must support tool calling.
# Pull it first:  ollama pull qwen3:8b
MODEL=qwen3:8b

# Where the local Ollama server is listening.
OLLAMA_HOST=http://localhost:11434

# Context window. Ollama's own default is 4096, which this app overflows on any
# roster-sized tool result — and it truncates silently rather than erroring, so
# the symptom is a slow, wrong answer rather than a clear failure. 8192 fits a
# 16GB machine; raise it if you have the memory.
CONTEXT_TOKENS=8192

# Let a reasoning model (qwen3) think before answering. Off by default, and
# that was measured rather than assumed: 12/12 in 4.3 min with it off against
# 11/12 in 15.1 min with it on. Re-check it if you switch models.
THINKING=false

# Local DuckDB file. Relative paths resolve against the project root.
DB_PATH=data/advisor.duckdb

# Where raw nflverse Parquet and cached Sleeper payloads land.
CACHE_DIR=data/cache

# Sleeper league id used when a command doesn't name one.
# Find it in the league URL: sleeper.com/leagues/<DEFAULT_LEAGUE_ID>/...
DEFAULT_LEAGUE_ID=
